---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/nhs-pay-calculator/" title="NHS take-home pay calculator" width="100%" height="900" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the NHS take-home pay calculator on your website" description="Add the NHS Agenda for Change take-home pay calculator to your website for free: one iframe, every band, step and nation for 2026/27, no sign-up and no cookies." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the NHS take-home pay calculator</h1>
    <p class="mt-3 text-lg text-navy-700">For a union branch page, a staff network, a recruitment page of a trust or a careers adviser: readers choose their band, step, nation and London area and see what reaches their account each month after the NHS pension, tax, NI and student loan.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Conditions: keep the credit line under the calculator visible, use it as it is and without warranty, and do not present it as advice from your organisation. When a new pay scale is published, the embedded calculator updates itself.</p>
    <p>Nothing your readers type reaches us and the frame sets no cookie. Questions: <a href={route('contact', lang)}>contact</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200"><iframe src="/embed/nhs-pay-calculator/" title="NHS take-home pay calculator" width="100%" height="900" style="border:0" loading="lazy"></iframe></div>
</PageLayout>
