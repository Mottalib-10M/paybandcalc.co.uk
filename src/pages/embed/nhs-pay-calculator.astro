---
/** Embeddable calculator (iframe): no navigation, noindex, out of the sitemap (astro.config). */
import '../../styles/global.css';
import NhsPayCalc from '../../components/calc/NhsPayCalc';
import { SITE_URL, SITE_NAMES } from '../../data/site-config';
import { route } from '../../i18n/routes';
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NHS take-home pay calculator 2026/27 (widget)</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}${route('nhs-take-home-pay', 'en')}`} />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <NhsPayCalc client:load methodHref={`${SITE_URL}${route('method', 'en')}`} idPrefix="emb" />
    <p class="mt-2 text-center text-xs text-navy-600"><a href={`${SITE_URL}/en/`} target="_blank" rel="noopener" class="underline">{SITE_NAMES.en}</a> · NHS Agenda for Change take-home pay, 2026/27, worked out in your browser</p>
  </body>
</html>
